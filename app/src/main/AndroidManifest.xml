<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Full-disk treemap / cleaner (Android 11+). Needs a Play "All files access" declaration. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Legacy storage (Android 8–12 / 8–9). Ignored by the OS on newer versions. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Scoped media mode (Android 13+ / 14+ partial access). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Unused-apps analyzer. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Vault. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Ads + billing only. File scanning never uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- See user-installed apps for the Unused Apps analyzer without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".StoragePulseApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StoragePulse"
        tools:targetApi="36">

        <!-- AdMob app id (test id in debug; see app/build.gradle.kts). Missing it crashes on start. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Android 13–16 Privacy Sandbox config for the ads SDK (replaces any SDK default). -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ad_services_config"
            tools:replace="android:resource" />
        <!-- Google's recommended flags: SDK init + ad loading work moves off the main thread
             (avoids a multi-second cold start / ANR risk). -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- No screenOrientation / resizeableActivity lock: Android 16 large-screen compliance. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home screen widgets (Jetpack Glance). They only read numbers; never delete. -->
        <receiver
            android:name=".ui.widgets.StorageBoostWidgetReceiver"
            android:exported="true"
            android:label="@string/wg_boost_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_storage_boost_info" />
        </receiver>

        <receiver
            android:name=".ui.widgets.DailyClutterWidgetReceiver"
            android:exported="true"
            android:label="@string/wg_clutter_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_clutter_info" />
        </receiver>

        <receiver
            android:name=".ui.widgets.MinimalStripWidgetReceiver"
            android:exported="true"
            android:label="@string/wg_strip_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_strip_info" />
        </receiver>
    </application>
</manifest>
