    <string name="disclosure_enclave">ENCLAVE: HARDWARE_SECURE</string>
    <string name="disclosure_headline">Why StoragePulse Needs File Access to Map Your Storage</string>
    <string name="disclosure_subhead">Deep file diagnostics happen exclusively on-device. No network relay, no external telemetry, and full control over your disk map.</string>

    <string name="card_treemap_title">Full Disk Treemap</string>
    <string name="card_treemap_sub">Android 11–16</string>
    <string name="card_treemap_badge">OS REQUIREMENT</string>
    <string name="card_treemap_body_prefix">Requires All Files Access (</string>
    <string name="card_treemap_body_code">MANAGE_EXTERNAL_STORAGE</string>
    <string name="card_treemap_body_suffix">) to accurately compute deep hierarchies, discover orphaned thumbnail bloat, and isolate multi-gigabyte messaging caches.</string>

    <string name="card_cloud_title">Zero Cloud Upload</string>
    <string name="card_cloud_sub">100% On-Device</string>
    <string name="card_cloud_badge">PRIVATE RAM</string>
    <string name="card_cloud_body">Your photos, media, and sensitive documents never leave your phone. AI duplicate detection and clustering run locally on your device.</string>

    <string name="card_trash_title">30-Day Safe Trash</string>
    <string name="card_trash_sub">Non-Destructive</string>
    <string name="card_trash_badge">ZERO DATA LOSS</string>
    <string name="card_trash_body">Nothing is permanently deleted without your explicit approval. Cleanup candidates are moved to a quarantined Safe Trash, recoverable anytime for 30 days.</string>

    <string name="sandbox_title">Local Sandbox Guarantee</string>
    <string name="sandbox_body">File scanning never uses the network. Internet is used only for optional ads and Google Play purchases.</string>

    <string name="cta_grant">Grant Storage Access &amp; Start Scan</string>
    <string name="cta_scoped">Scan Media Photos/Videos Only (Scoped Mode)</string>

    <string name="policy_dialog_title">How StoragePulse uses storage access</string>
    <string name="policy_dialog_body">All Files Access lets StoragePulse measure every folder for the Disk Usage treemap, find duplicates and large files, and clean app caches.\n\nEverything is analysed on your phone. No files, file names or scan results are uploaded.\n\nPrefer less access? Choose Scoped Mode to scan only the photos and videos you allow.</string>
